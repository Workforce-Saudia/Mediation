# Copy to .env for local development, and add the same variables in
# Netlify → Site configuration → Environment variables

# Public (safe in the browser) – Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Staff log in with a username; internally it becomes username@<this domain>.
# Keep it as is unless you have a reason to change it (must match on server + browser).
VITE_USERNAME_DOMAIN=staff.wfs.local

# SERVER ONLY (Netlify function for creating/deactivating users). Never prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
